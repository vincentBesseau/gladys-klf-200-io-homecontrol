{
  "manifest_version": 1,
  "type": "device",
  "name": "KLF200 - io-homecontrol",
  "description": {
    "en": "Discover and control io-homecontrol shutters already paired to a Velux KLF200 gateway.",
    "fr": "Découvre et pilote les volets io-homecontrol déjà appairés à une passerelle Velux KLF200."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/vincentbesseau/gladys-klf-200-io-homecontrol:1.0.1",
  "cover_image": "https://raw.githubusercontent.com/vincentBesseau/gladys-klf-200-io-homecontrol/main/assets/cover.png",
  "gladys_version": ">=4.86.0",
  "categories": ["lighting"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "KLF200 gateway",
        "fr": "Passerelle KLF200"
      },
      "description": {
        "en": "Shutters must already be paired via the Velux app or the gateway's own UI.",
        "fr": "Les volets doivent déjà être appairés via l'appli Velux ou l'interface du KLF200."
      }
    },
    {
      "key": "klf200_ip",
      "type": "string",
      "label": {
        "en": "KLF200 IP address",
        "fr": "Adresse IP du KLF200"
      },
      "required": true
    },
    {
      "key": "klf200_password",
      "type": "secret",
      "label": {
        "en": "KLF200 password",
        "fr": "Mot de passe du KLF200"
      },
      "required": true
    },
    {
      "key": "klf200_fingerprint",
      "type": "string",
      "label": {
        "en": "TLS fingerprint (optional)",
        "fr": "Empreinte TLS (optionnelle)"
      },
      "description": {
        "en": "Leave empty to skip certificate pinning.",
        "fr": "Laisser vide pour ne pas épingler le certificat."
      },
      "required": false
    }
  ]
}
